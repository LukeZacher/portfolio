# Resend API key with sending access (starts with "re_")
RESEND_API_KEY=
# Where contact form messages are delivered
CONTACT_TO_EMAIL=
# Sender shown on contact emails; domain must be verified in Resend
CONTACT_FROM_EMAIL=

# Upstash Redis REST connection, used to rate limit the contact form
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=